<Window x:Class="Reolmarkedet.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reolmarkedet.WPF"
        xmlns:views="clr-namespace:Reolmarkedet.WPF.Views"
        xmlns:vm="clr-namespace:Reolmarkedet.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Reolmarkedet" Height="450" Width="900"
        MinHeight="360" MinWidth="760">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TenantViewModel}">
            <views:TenantView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShelfViewModel}">
            <views:ShelfView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Margin="12">
            <Button Content="Overblik"
                    Command="{Binding ShowDashboardCommand}"
                    Padding="8" Margin="0,0,0,8" />

            <Button Content="Reollejere"
                    Command="{Binding ShowTenantsCommand}"
                    Padding="8" Margin="0,0,0,8"/>

            <Button Content="Reolstyring"
                    Command="{Binding ShowShelfManagementCommand}"
                    Padding="8" />

        </StackPanel>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>

</Window>
