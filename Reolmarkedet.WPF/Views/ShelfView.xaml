<UserControl x:Class="Reolmarkedet.WPF.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.WPF.Views"
             xmlns:models="clr-namespace:Reolmarkedet.Core.Models;assembly=Reolmarkedet.Core"
             xmlns:vm="clr-namespace:Reolmarkedet.WPF.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reoler"
                   FontSize="24" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">

            <Expander Header="Tilføj reol"
                      IsExpanded="False"
                      Margin="0,0,0,12">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Reolnummer" Margin="0,0,0,4" />

                    <TextBox Width="260"
                             Height="24"
                             VerticalContentAlignment="Center"
                             HorizontalAlignment="Left"
                             Text="{Binding NewShelfNumber,
                             Mode=TwoWay,
                             UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Reoltype" Margin="0,8,0,4" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <ComboBox Width="260"
                                  ItemsSource="{Binding ShelfTypes}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding NewShelfType,
                                  Mode=TwoWay}" />

                        <Button Content="Tilføj reol"
                                Command="{Binding AddShelfCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="Administrer reoltyper"
                      IsExpanded="False"
                      Margin="0,0,0,12">

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Ny reoltype" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <TextBox Width="260"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewShelfTypeName,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Tilføj reoltype"
                                Command="{Binding AddShelfTypeCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4" />
                    </StackPanel>
                    <TextBlock Text="Slet reoltype"
                               Margin="0,8,0,4" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <ComboBox Width="260"
                                  ItemsSource="{Binding ShelfTypes}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding ShelfTypeToDelete,
                                  Mode=TwoWay}" />

                        <Button Content="Slet reoltype"
                                Command="{Binding DeleteShelfTypeCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4" />
                    </StackPanel>

                    <TextBlock Text="{Binding ShelfTypeMessage}"
                               Foreground="DarkRed"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal">

                <Button Content="Slet valgt reol"
                        Command="{Binding DeleteShelfCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,8,12"
                        Padding="8,4" />

                <Button Content="Deaktiver valgt reol"
                        Command="{Binding DeactivateShelfCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Padding="8,4" />
            </StackPanel>

            <TextBlock Text="{Binding ShelfMessage}"
                       Foreground="DarkRed"
                       TextWrapping="Wrap"
                       Margin="0,8,0,8" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,12">
                <TextBlock Text="Filtrer reoler efter status:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <ComboBox Width="180"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="Alle"
                                  Tag="{x:Static vm:ShelfStatusFilter.All}" />
                    <ComboBoxItem Content="Ledige"
                                  Tag="{x:Static vm:ShelfStatusFilter.Available}" />
                    <ComboBoxItem Content="Udlejede"
                                  Tag="{x:Static vm:ShelfStatusFilter.Rented}" />
                    <ComboBoxItem Content="Opsagte"
                                  Tag="{x:Static vm:ShelfStatusFilter.TerminationPending}" />
                </ComboBox>

            </StackPanel>
        </StackPanel>

        <!-- Shelf List-->
        <DataGrid Grid.Row="2" ItemsSource="{Binding VisibleShelves}"
                  SelectedItem="{Binding SelectedShelfRow, Mode=TwoWay}"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False">

            <DataGrid.Resources>
                <Style x:Key="ShelfCellTextStyle" TargetType="TextBlock">
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Reolnummer"
                                    Binding="{Binding ShelfNumber}"
                                    Width="120"
                                    ElementStyle="{StaticResource ShelfCellTextStyle}"/>

                <DataGridTextColumn Header="Nuværende lejer"
                                    Binding="{Binding CurrentTenantName}"
                                    Width="240"
                                    ElementStyle="{StaticResource ShelfCellTextStyle}"/>

                <DataGridTemplateColumn Header="Status" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Padding="8,4"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Ukendt" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShelfStatus}"
                                                         Value="{x:Static models:ShelfStatus.Available}">
                                                <Setter Property="Text" Value="Ledig" />
                                                <Setter Property="Background" Value="PaleGreen" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ShelfStatus}"
                                                         Value="{x:Static models:ShelfStatus.Rented}">
                                                <Setter Property="Text" Value="Udlejet" />
                                                <Setter Property="Background" Value="LightCoral" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ShelfStatus}"
                                                         Value="{x:Static models:ShelfStatus.TerminationPending}">
                                                <Setter Property="Text" Value="Opsagt" />
                                                <Setter Property="Background" Value="LightGoldenrodYellow" />
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Reoltype" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.ShelfTypes,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                DisplayMemberPath="Name"
                                SelectedItem="{Binding ShelfType, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
