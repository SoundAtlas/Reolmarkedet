<UserControl x:Class="Reolmarkedet.WPF.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reoler"
                   FontSize="24" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">

            <CheckBox Content="Vis kun reoler ledige i dag"
                      IsChecked="{Binding ShowOnlyAvailableShelves, Mode=TwoWay}"
                      Margin="0,0,0,12" />

            <Expander Header="Tilføj reol"
                      IsExpanded="False"
                      Margin="0,0,0,12">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Reolnummer" Margin="0,0,0,4" />

                    <TextBox Width="260"
                             Height="24"
                             VerticalContentAlignment="Center"
                             HorizontalAlignment="Left"
                             Text="{Binding NewShelfNumber,
                             Mode=TwoWay,
                             UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Reoltype" Margin="0,8,0,4" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <ComboBox Width="260"
                                  ItemsSource="{Binding ShelfTypes}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding NewShelfType,
                                  Mode=TwoWay}" />

                        <Button Content="Tilføj reol"
                                Command="{Binding AddShelfCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4" />
                    </StackPanel>

                    <TextBlock Text="{Binding ShelfMessage}"
                               Foreground="DarkRed"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Expander>

            <Expander Header="Administrer reoltyper"
                      IsExpanded="False"
                      Margin="0,0,0,12">

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Ny reoltype" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <TextBox Width="260"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewShelfTypeName,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Tilføj reoltype"
                                Command="{Binding AddShelfTypeCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4" />
                    </StackPanel>
                    <TextBlock Text="Slet reoltype"
                               Margin="0,8,0,4" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <ComboBox Width="260"
                                  ItemsSource="{Binding ShelfTypes}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding ShelfTypeToDelete,
                                  Mode=TwoWay}" />

                        <Button Content="Slet reoltype"
                                Command="{Binding DeleteShelfTypeCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4" />
                    </StackPanel>

                    <TextBlock Text="{Binding ShelfTypeMessage}"
                               Foreground="DarkRed"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Expander>

            <Button Content="Slet valgt reol"
                    Command="{Binding DeleteShelfCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    Padding="8,4" />

        </StackPanel>


        <DataGrid Grid.Row="2" ItemsSource="{Binding VisibleShelves}"
                  SelectedItem="{Binding SelectedShelfRow, Mode=TwoWay}"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reolnummer"
                                    Binding="{Binding ShelfNumber}"
                                    Width="120" />

                <DataGridTemplateColumn Header="Reoltype" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.ShelfTypes,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                DisplayMemberPath="Name"
                                SelectedItem="{Binding ShelfType, Mode=OneWay,
                                UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding ShelfStatus}"
                                    Width="160" />

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
