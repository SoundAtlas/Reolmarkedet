<UserControl x:Class="Reolmarkedet.WPF.Views.RentalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Width="300" HorizontalAlignment="Left">
                <TextBlock Text="Opret lejemål"
                           FontSize="24"
                           Margin="0,0,0,16" />

                <TextBlock Text="Reollejer" />
                <ComboBox ItemsSource="{Binding ActiveTenants}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedTenant, Mode=TwoWay}"
                          MinHeight="30"
                          Margin="0,4,0,12" />

                <TextBlock Text="Startdato" />
                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                            MinHeight="30"
                            Margin="0,4,0,12" />

                <TextBlock Text="Slutdato (valgfri)" />
                <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                            MinHeight="30"
                            Margin="0,4,0,12" />

                <TextBlock Text="Ledig reol i den valgte periode" />
                <ComboBox ItemsSource="{Binding AvailableShelves}"
                          DisplayMemberPath="ShelfNumber"
                          SelectedItem="{Binding SelectedShelf, Mode=TwoWay}"
                          MinHeight="30"
                          Margin="0,4,0,12" />

                <Button Content="Tilføj reol"
                        Command="{Binding AddShelfToSelectionCommand}"
                        MinHeight="30"
                        Margin="0,0,0,12" />

                <TextBlock Text="Valgte reoler:" Margin="0,0,0,4" />

                <ItemsControl ItemsSource="{Binding SelectedShelves}"
                              Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right"
                                        Content="Fjern"
                                        Padding="8,4"
                                        Command="{Binding DataContext.RemoveShelfFromSelectionCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />

                                <TextBlock Text="{Binding ShelfNumber}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Aftalt månedlig leje pr. reol (kr.)"/>

                <TextBox Text="{Binding MonthlyRent,
                         Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsCustomPrice}"
                         MinHeight="30"
                         Padding="6,3"
                         Margin="0,4,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Angiv specialpris"
                            Command="{Binding EnableCustomPriceCommand}"
                            Padding="8,4"
                            Margin="0,0,8,0" />

                    <Button Content="Brug standardpris"
                            Command="{Binding UseStandardPriceCommand}"
                            Padding="8,4" />
                </StackPanel>

                <TextBlock Text="Samlet månedlig leje for valgte reoler"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding TotalMonthlyRent,
                           StringFormat='{}{0:N2} kr.',
                           TargetNullValue='Ugyldig pris'}"
                           Margin="0,4,0,12" />



                <Button Content="Opret lejemål"
                        Command="{Binding CreateRentalsCommand}"
                        MinHeight="30"
                        Margin="0,0,0,12" />

                <TextBlock Text="{Binding RentalMessage}"
                           Foreground="Red"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Lejemål og historik"
                       FontSize="24"
                       Margin="0,0,0,16" />

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding RentalRows}"
                      SelectedItem="{Binding SelectedRentalRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding RentalId}"
                                        Width="50" />

                    <DataGridTextColumn Header="Reollejer"
                                        Binding="{Binding TenantName}"
                                        Width="*"
                                        MinWidth="140" />

                    <DataGridTextColumn Header="Reol"
                                        Binding="{Binding ShelfNumber}"
                                        Width="60" />

                    <DataGridTextColumn Header="Startdato"
                                        Binding="{Binding StartDate,
                                        StringFormat=dd-MM-yyyy}"
                                        Width="110" />

                    <DataGridTextColumn Header="Slutdato"
                                        Binding="{Binding EndDate,
                                        StringFormat=dd-MM-yyyy,
                                        TargetNullValue='—'}"
                                        Width="110" />

                    <DataGridTextColumn Header="Månedlig leje"
                                        Binding="{Binding MonthlyRent,
                                        StringFormat='{}{0:N2} kr.'}"
                                        Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,12,0,0">

                <StackPanel>
                    <TextBlock Text="Opsig valgt lejemål"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Sidste lejedag"
                               Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding TerminationEndDate,
                                    Mode=TwoWay}"
                                    Width="180"
                                    MinHeight="30" />

                        <Button Content="Opsig lejemål"
                                Command="{Binding TerminateRentalCommand}"
                                Padding="12,4"
                                MinHeight="30"
                                Margin="12,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding TerminationMessage}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>


</UserControl>
